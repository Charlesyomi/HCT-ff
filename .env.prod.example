# Copy to `.env` on the host and fill in. `.env` is gitignored.
#   cp .env.prod.example .env
# Required values use the form VAR=value; the compose file uses ${VAR:?...} so a missing
# one aborts `up` instead of starting with a default.

# --- Domain / TLS -------------------------------------------------------------------
# The apex or subdomain Caddy will serve. Must already have an A/AAAA record pointing here.
DOMAIN=www.example.com
# Let's Encrypt expiry notices go here.
ACME_EMAIL=you@example.com

# --- Application -------------------------------------------------------------------
APP_ENV=production
# Generate: openssl rand -hex 32
SECRET_KEY=
# Must match DOMAIN exactly (scheme included) or CORS rejects browser calls.
WEB_ORIGIN=https://www.example.com
SITE_URL=https://www.example.com
# Generate: openssl rand -hex 32   (shared with the web app's /api/revalidate)
REVALIDATE_SECRET=

# --- Database (Supabase) ------------------------------------------------------------
# POOLED / transaction mode (port 6543) for runtime. Must end with ?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@POOLER.host:6542/postgres?sslmode=require
# DIRECT / session mode for Alembic. Never point migrations at the 6543 pooler (ADR 13).
DATABASE_URL_DIRECT=postgresql+psycopg://postgres.PROJECT:PASSWORD@POOLER.host:5432/postgres?sslmode=require

# --- Email (ADR 6: Brevo) -----------------------------------------------------------
EMAIL_PROVIDER=brevo
BREVO_API_KEY=xkeys-your-key
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Adesoba Farm
# Where new-order notifications are sent.
FARM_NOTIFY_EMAIL=you@gmail.com

# --- Spam protection ----------------------------------------------------------------
# Cloudflare Turnstile secret (API side). Leave blank to disable verification.
TURNSTILE_SECRET_KEY=
# Site key (web side, public). Leave blank to hide the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Google sign-in (optional) ------------------------------------------------------
# Leave these three blank and sign-in stays switched off; phone checkout still works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be https://<DOMAIN>/api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=
NEXT_PUBLIC_GOOGLE_SIGN_IN_ENABLED=false

# Shared secret for the API -> web revalidation hook. Must match REVALIDATE_SECRET on the API.
# Both sides blank means on-demand revalidation stays off and the pages rely on their 60s timer.
REVALIDATE_SECRET=

# Shared secret for the API -> web revalidation hook. Must match REVALIDATE_SECRET on the API.
REVALIDATE_SECRET=
