{
    "expo": {
        "name": "HCT Fish Farms",
        "slug": "adesoba-farm-mobile",
        "version": "1.0.0",
        "orientation": "portrait",
        "scheme": "adesoba",
        "userInterfaceStyle": "light",
        "plugins": [
            "expo-router",
            "expo-secure-store",
            "expo-font",
            "@react-native-community/datetimepicker"
        ],
        "android": {
            "package": "com.adesoba.farm"
        },
        "ios": {
            "supportsTablet": true
        },
        "experiments": {
            "typedRoutes": true
        }
    }
}