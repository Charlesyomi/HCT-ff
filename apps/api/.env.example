APP_ENV=development
WEB_ORIGIN=http://localhost:3000
# Runtime uses the transaction pooler (port 6543); migrations use the direct endpoint.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/adesoba
DATABASE_URL_DIRECT=postgresql+psycopg://postgres:postgres@localhost:5432/adesoba
DATABASE_POOL_MAX_SIZE=5
DATABASE_POOL_MAX_OVERFLOW=5
DATABASE_CONNECT_RETRIES=5
DATABASE_CONNECT_BACKOFF_SECONDS=2
SECRET_KEY=change-me
# Cloudflare Turnstile (optional in dev; enforced by the API when set)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Transactional email (Addendum §A3): console prints in dev; brevo|mailgun|smtp send for real
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Adesoba Farm
EMAIL_REPLY_TO=
FARM_NOTIFY_EMAIL=
EMAIL_WORKER_ENABLED=true
EMAIL_WORKER_INTERVAL_SECONDS=30
BREVO_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_BASE_URL=https://api.mailgun.net
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Google sign-in (Addendum §A4) - leave unset to keep the feature switched off
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
SESSION_COOKIE_SECURE=false
REQUIRE_LOGIN_AT_CHECKOUT=false
