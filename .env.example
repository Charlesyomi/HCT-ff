NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://localhost:8000
SITE_URL=http://localhost:3000
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/adesoba
DATABASE_URL_DIRECT=postgresql+psycopg://postgres:postgres@localhost:5432/adesoba
APP_ENV=development
# Cloudflare Turnstile site key (optional; leave empty to disable the widget in dev)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_GOOGLE_SIGN_IN_ENABLED=false

# Mobile client sign-in (comma-separated allowlist for /auth/google/start?client=mobile).
# Entries match exactly (e.g. adesoba://auth). An entry ending in `://` (e.g. exp://) is a
# development-only prefix and is ignored unless APP_ENV=development.
MOBILE_REDIRECT_ALLOWLIST=
# Opt-in: also allow `exp://` redirects outside development. Keep false in production.
MOBILE_ALLOW_EXPO_REDIRECTS=false
# Shared secret for the API -> web revalidation hook (SPEC §8). Must match the API value.
REVALIDATE_SECRET=

# Shared secret for the API -> web revalidation hook (SPEC §8). Must match the API value.
REVALIDATE_SECRET=
